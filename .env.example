# Copy this file to .env and adjust values. Never commit your real .env file.
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Upload limit in megabytes
MAX_UPLOAD_MB=100

# Whisper model: base (faster) or small (more accurate)
WHISPER_MODEL=base
# auto | cpu | cuda
DEVICE=auto
# Long audio is split into chunks of this many seconds
AUDIO_CHUNK_SECONDS=300

# Hugging Face summarization model (any seq2seq summarization model)
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
TEXT_CHUNK_WORDS=350

# Generated reports are deleted after this many hours
EXPORT_RETENTION_HOURS=24

# Optional: full paths if FFmpeg is not on PATH
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe
